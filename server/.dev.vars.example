# Copy to .dev.vars for `npx wrangler dev` (never commit .dev.vars).
SITE_ORIGIN="http://localhost:8437"
SITE_URL="http://localhost:8437"
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
SESSION_SECRET="run: openssl rand -base64 48"
